<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.groma</groupId>
        <artifactId>groma-models</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>model-emergency-deduction</artifactId>
    <name>Groma Compiled Model :: 应急决策推演-关联副本-1029 (v647)</name>
    <description>由方圆模型「应急决策推演-关联副本-1029」编译产出的独立五层业务模块（模型 id：3cW2TNyvVxiJxV07ZlR）。只依赖 groma-base 公共底座，不依赖其它模型子模块。</description>

    <!-- 严格遵循 NP-GEN-005：模型子模块只依赖 groma-base 公共底座 -->
    <dependencies>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-websocket</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.25</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 同步生成 *-sources.jar：大模型与开发者读取源码目录或二进制包时中文业务语义零丢失 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
