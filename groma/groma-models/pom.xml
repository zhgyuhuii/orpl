<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.groma</groupId>
        <artifactId>groma</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>groma-models</artifactId>
    <packaging>pom</packaging>
    <name>Groma Compiled Business Models</name>

    <!-- 流水线生成模块的仓内合包槽位（code4.html E2 收割）：
         模块目录由 ModelPipelineService 的 repo-models-root 同步写入（同步时自动重写本 modules 清单），
         手写演示样例已迁至 examples-handwritten/（不占用主工程槽位）。
         空清单 = 仓库尚未同步任何生成模型，直接 mvn clean package 时 groma-models 为纯聚合壳。 -->
    <profiles>
        <!-- 模式一：多模型合包构建（模块清单由流水线同步维护） -->
        <profile>
            <id>multi-models-default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>model-emergency-deduction-844676b1</module>
                </modules>
        </profile>

        <!-- 模式二：单模型精简独立交付 (-Psingle-model -Dtarget.model=model-emergency-deduction) -->
        <profile>
            <id>single-model</id>
            <properties>
                <target.model>model-emergency-deduction</target.model>
            </properties>
            <modules>
                <module>${target.model}</module>
            </modules>
        </profile>
    </profiles>
</project>
