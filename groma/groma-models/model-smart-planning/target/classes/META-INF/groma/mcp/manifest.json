{
  "manifestFormatVersion": "1.0",
  "modelCode": "smart-planning",
  "modelVersion": "844",
  "modelLabel": "智能筹划应用",
  "processes": [
    {
      "ref": "compute_synchronized_routes",
      "entityId": "b094d31f83d44a2886a714bd999e414e",
      "name": "航路规划与同步到达算法",
      "description": "给定 H 时同步到达目标秒数与多基地可用兵力坐标速度，反推各编队精确起飞时刻、航程(km)与到达误差",
      "kind": "operator",
      "timeConsuming": false,
      "inputSchema": {
        "type": "object",
        "required": ["hHourSec", "forces"],
        "properties": {
          "hHourSec": { "type": "integer", "minimum": 60, "description": "H 时同步突击目标时刻（场景开始后秒数）" },
          "forces": { "type": "array", "description": "参演兵力编队与基地目标经纬度列表" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "routes": { "type": "array", "description": "按起飞时刻排序的同步航线规划结果" }
        }
      },
      "preconditions": []
    }
  ]
}
