<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.groma</groupId>
        <artifactId>groma</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>groma-bootstrap</artifactId>
    <name>Groma Simulation Unified Host Bootstrap</name>
    <dependencies>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-websocket</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-base-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-debug-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.groma</groupId>
            <artifactId>groma-compiler-hotswap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 合包模型交付走两条路（E1 决策：手写示例模块无运行时入口且类名与生成模块冲突，示例模块保持不动）：
             1) 运行期热挂载：POST /api/v1/studio/models/build 构建后经 GromaModelRegistry 版本钉住挂载（默认）；
             2) 静态合包交付：GET /api/v1/studio/workspace/export-zip 导出含所选生成模型的源码工程 ZIP，
                产物 mvn clean package 即得内置模型的宿主 JAR（scanBasePackages 的 com.groma.models 保留） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- 仓内生成模型静态合包（code4.html E2 收割，说明书 1.3 模式一"常态多模型合包独立运行"）：
             前置 = ModelPipelineService 配置 groma.pipeline.repo-models-root 指向仓库 groma-models
             完成至少一次构建同步（模块目录与 SPI 随包）；此后 -Pbundled-models 打出的可执行 JAR
             经 ServiceLoader 开箱挂载全部仓内生成模型。artifactId 稳定（无语料短哈希后缀），
             目录名带哈希隔离多版本，仓内同基础名仅保留最新一份。 -->
        <profile>
            <id>bundled-models</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <dependencies>
                <!-- 逐模型稳定坐标依赖（artifactId 无哈希；同步后仓内每基础名恰一份，reactor 直取） -->
                <dependency>
                    <groupId>com.groma</groupId>
                    <artifactId>model-emergency-deduction</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.groma</groupId>
                    <artifactId>model-smart-planning</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
